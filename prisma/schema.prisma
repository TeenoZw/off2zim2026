// Off2Zim Travel Platform Database Schema
// Zimbabwe Tourism Database with Booking, Payment, and User Management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication and User Management
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  firstName     String?
  lastName      String?
  name          String?
  email         String    @unique
  passwordHash  String?
  role          String    @default("explorer")
  verificationStatus String @default("pending")
  hasVerifiedBadge Boolean @default(false)
  explorerType  String?
  emailVerified DateTime?
  image         String?
  phone         String?
  nationality   String?
  preferences   String?     @default("{}")
  explorerScore String?     @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  bookings               Booking[]
  reviews                Review[]
  payments               Payment[]
  ownedCompanies         ProviderCompany[]   @relation("CompanyOwner")
  verificationReviews    ProviderVerificationReview[] @relation("AdminVerificationReviews")
  openedDisputes         Dispute[]           @relation("OpenedDisputes")
  disputeAssignments     Dispute[]           @relation("AssignedDisputes")
  auditLogs              AdminAuditLog[]     @relation("AdminAuditActor")
  
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Tourism Content Models
model Hotel {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  category    String
  priceRange  String
  rating      Float?   @default(0)
  images      String?  @default("[]")
  amenities   String?  @default("[]")
  rooms       Room[]
  bookings    Booking[]
  reviews     Review[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hotels")
}

model Room {
  id          String  @id @default(cuid())
  hotelId     String
  name        String
  description String?
  capacity    Int
  price       Float
  currency    String  @default("USD")
  images      String? @default("[]")
  amenities   String? @default("[]")
  isAvailable Boolean @default(true)

  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("rooms")
}

model Activity {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  duration    String?
  difficulty  String?
  location    String
  price       Float
  currency    String   @default("USD")
  images      String?  @default("[]")
  includes    String?  @default("[]")
  excludes    String?  @default("[]")
  rating      Float?   @default(0)
  maxGuests   Int?
  bookings    Booking[]
  reviews     Review[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("activities")
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  description String?
  cuisine     String
  location    String
  priceRange  String
  rating      Float?   @default(0)
  images      String?  @default("[]")
  specialties String?  @default("[]")
  amenities   String?  @default("[]")
  bookings    Booking[]
  reviews     Review[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("restaurants")
}

model Event {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  location    String
  startDate   DateTime
  endDate     DateTime?
  price       Float
  currency    String   @default("USD")
  images      String?  @default("[]")
  capacity    Int?
  bookings    Booking[]
  reviews     Review[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

// Booking System
model Booking {
  id                String        @id @default(cuid())
  userId            String
  providerId        String?
  listingId         String?
  bookingType       String        @default("HOTEL")
  status            String        @default("PENDING")
  totalAmount       Float
  currency          String        @default("USD")
  confirmationNumber String       @unique
  checkIn           DateTime?
  checkOut          DateTime?
  guests            Int?
  specialRequests   String?
  metadata          String?         @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relationships
  user              User             @relation(fields: [userId], references: [id])
  provider          ProviderCompany? @relation("ProviderBookings", fields: [providerId], references: [id])
  listing           ProviderListing? @relation(fields: [listingId], references: [id])
  payments          Payment[]
  disputes          Dispute[]
  
  // Tourism relationships (one-to-one with each type)
  hotel      Hotel?      @relation(fields: [hotelId], references: [id])
  hotelId    String?
  room       Room?       @relation(fields: [roomId], references: [id])
  roomId     String?
  activity   Activity?   @relation(fields: [activityId], references: [id])
  activityId String?
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  restaurantId String?
  event      Event?      @relation(fields: [eventId], references: [id])
  eventId    String?

  @@map("bookings")
}

// Payment System
model Payment {
  id              String            @id @default(cuid())
  bookingId       String
  userId          String
  amount          Float
  currency        String            @default("USD")
  method          String            @default("CARD")
  status          String            @default("PENDING")
  stripePaymentId String?
  mobileProvider  String?
  phoneNumber     String?
  reference       String?
  metadata        String?             @default("{}")
  processedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("payments")
}

// Review System
model Review {
  id          String   @id @default(cuid())
  userId      String
  rating      Int
  comment     String?
  images      String?  @default("[]")
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  
  // Review can be for any tourism item
  hotel        Hotel?       @relation(fields: [hotelId], references: [id])
  hotelId      String?
  activity     Activity?    @relation(fields: [activityId], references: [id])
  activityId   String?
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])
  restaurantId String?
  event        Event?       @relation(fields: [eventId], references: [id])
  eventId      String?

  @@map("reviews")
}

model ProviderCompany {
  id                         String   @id @default(cuid())
  ownerUserId                String
  companyName                String
  tradingName                String?
  businessRegistrationNumber String
  mainContactPerson          String
  businessPhone              String
  businessEmail              String
  physicalAddress            String
  headquartersCity           String?
  businessCategory           String?
  businessDescription        String?
  establishedYear            Int?
  numberOfEmployees          String?
  operatingHours             String?
  websiteUrl                 String?
  socialMediaLinks           String?  @default("{}")
  servicesOffered            String?  @default("[]")
  serviceAreas               String?  @default("[]")
  onboardingStatus           String   @default("draft")
  verificationTier           String   @default("basic")
  reviewSubmittedAt          DateTime?
  basicApprovedAt            DateTime?
  verifiedBadgeExpiresAt     DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  owner               User                         @relation("CompanyOwner", fields: [ownerUserId], references: [id])
  documents           ProviderDocument[]
  listings            ProviderListing[]
  bookings            Booking[]                    @relation("ProviderBookings")
  verificationReviews ProviderVerificationReview[]
  disputes            Dispute[]
  auditLogs           AdminAuditLog[]

  @@unique([ownerUserId])
  @@index([onboardingStatus])
  @@index([verificationTier])
}

model ProviderDocument {
  id          String   @id @default(cuid())
  companyId   String
  type        String
  fileName    String
  fileUrl     String?
  status      String   @default("pending")
  notes       String?
  uploadedAt  DateTime @default(now())
  reviewedAt  DateTime?

  company ProviderCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

model ProviderVerificationReview {
  id              String   @id @default(cuid())
  companyId       String
  reviewedById    String?
  reviewType      String   @default("basic_review")
  status          String   @default("pending")
  notes           String?
  internalSummary String?
  createdAt       DateTime @default(now())
  reviewedAt      DateTime?

  company     ProviderCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewedBy  User?           @relation("AdminVerificationReviews", fields: [reviewedById], references: [id])

  @@index([companyId, status])
}

model ProviderListing {
  id                   String   @id @default(cuid())
  companyId            String
  title                String
  slug                 String   @unique
  category             String
  listingType          String
  shortDescription     String?
  description          String
  location             String
  pricingModel         String   @default("per_service")
  basePrice            Float?
  currency             String   @default("USD")
  instantBooking       Boolean  @default(false)
  bookingMode          String   @default("request")
  status               String   @default("draft")
  visibility           String   @default("private")
  capacity             Int?
  pickupLeadTimeHours  Int?
  images               String?  @default("[]")
  tags                 String?  @default("[]")
  amenities            String?  @default("[]")
  policies             String?  @default("{}")
  metadata             String?  @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company          ProviderCompany      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  availability     ListingAvailability[]
  bookings         Booking[]

  @@index([companyId, status])
  @@index([category, visibility, status])
}

model ListingAvailability {
  id             String   @id @default(cuid())
  listingId      String
  startDate      DateTime
  endDate        DateTime
  unitsAvailable Int?
  status         String   @default("available")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listing ProviderListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate, endDate])
}

model Dispute {
  id              String   @id @default(cuid())
  bookingId       String
  companyId       String?
  openedByUserId  String
  assignedAdminId String?
  reason          String
  details         String?
  status          String   @default("open")
  resolution      String?
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  booking       Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  company       ProviderCompany? @relation(fields: [companyId], references: [id])
  openedBy      User             @relation("OpenedDisputes", fields: [openedByUserId], references: [id])
  assignedAdmin User?            @relation("AssignedDisputes", fields: [assignedAdminId], references: [id])

  @@index([status, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  companyId   String?
  action      String
  targetType  String
  targetId    String
  summary     String
  metadata    String?  @default("{}")
  createdAt   DateTime @default(now())

  admin   User             @relation("AdminAuditActor", fields: [adminUserId], references: [id])
  company ProviderCompany? @relation(fields: [companyId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
}
