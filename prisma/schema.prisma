// Off2Zim Travel Platform Database Schema
// Zimbabwe Tourism Database with Booking, Payment, and User Management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Authentication and User Management
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  nationality   String?
  preferences   String?     @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  bookings     Booking[]
  reviews      Review[]
  payments     Payment[]
  
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Tourism Content Models
model Hotel {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  category    String
  priceRange  String
  rating      Float?   @default(0)
  images      String?  @default("[]")
  amenities   String?  @default("[]")
  rooms       Room[]
  bookings    Booking[]
  reviews     Review[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hotels")
}

model Room {
  id          String  @id @default(cuid())
  hotelId     String
  name        String
  description String?
  capacity    Int
  price       Float
  currency    String  @default("USD")
  images      String? @default("[]")
  amenities   String? @default("[]")
  isAvailable Boolean @default(true)

  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("rooms")
}

model Activity {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  duration    String?
  difficulty  String?
  location    String
  price       Float
  currency    String   @default("USD")
  images      String?  @default("[]")
  includes    String?  @default("[]")
  excludes    String?  @default("[]")
  rating      Float?   @default(0)
  maxGuests   Int?
  bookings    Booking[]
  reviews     Review[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("activities")
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  description String?
  cuisine     String
  location    String
  priceRange  String
  rating      Float?   @default(0)
  images      String?  @default("[]")
  specialties String?  @default("[]")
  amenities   String?  @default("[]")
  bookings    Booking[]
  reviews     Review[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("restaurants")
}

model Event {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  location    String
  startDate   DateTime
  endDate     DateTime?
  price       Float
  currency    String   @default("USD")
  images      String?  @default("[]")
  capacity    Int?
  bookings    Booking[]
  reviews     Review[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

// Booking System
model Booking {
  id                String        @id @default(cuid())
  userId            String
  bookingType       String        @default("HOTEL")
  status            String        @default("PENDING")
  totalAmount       Float
  currency          String        @default("USD")
  confirmationNumber String       @unique
  checkIn           DateTime?
  checkOut          DateTime?
  guests            Int?
  specialRequests   String?
  metadata          String?         @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relationships
  user       User        @relation(fields: [userId], references: [id])
  payments   Payment[]
  
  // Tourism relationships (one-to-one with each type)
  hotel      Hotel?      @relation(fields: [hotelId], references: [id])
  hotelId    String?
  room       Room?       @relation(fields: [roomId], references: [id])
  roomId     String?
  activity   Activity?   @relation(fields: [activityId], references: [id])
  activityId String?
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  restaurantId String?
  event      Event?      @relation(fields: [eventId], references: [id])
  eventId    String?

  @@map("bookings")
}

// Payment System
model Payment {
  id              String            @id @default(cuid())
  bookingId       String
  userId          String
  amount          Float
  currency        String            @default("USD")
  method          String            @default("CARD")
  status          String            @default("PENDING")
  stripePaymentId String?
  mobileProvider  String?
  phoneNumber     String?
  reference       String?
  metadata        String?             @default("{}")
  processedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("payments")
}

// Review System
model Review {
  id          String   @id @default(cuid())
  userId      String
  rating      Int
  comment     String?
  images      String?  @default("[]")
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  
  // Review can be for any tourism item
  hotel        Hotel?       @relation(fields: [hotelId], references: [id])
  hotelId      String?
  activity     Activity?    @relation(fields: [activityId], references: [id])
  activityId   String?
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])
  restaurantId String?
  event        Event?       @relation(fields: [eventId], references: [id])
  eventId      String?

  @@map("reviews")
}
